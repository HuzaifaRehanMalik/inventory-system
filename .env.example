# Copy to .env and fill in. Variables are validated in lib/env.ts.

# PostgreSQL connection string (e.g. Neon, Supabase, local)
DATABASE_URL="postgresql://user:password@localhost:5432/stockeyfy"
# Optional: max pooled connections (1-20)
# DATABASE_POOL_MAX=5

# Auth.js: AUTH_SECRET must be at least 32 characters (npx auth secret)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Optional: trust X-Forwarded-For for rate limiting (only behind a trusted proxy)
# TRUSTED_PROXY_HEADERS=false
# Optional: log query timings
# PERFORMANCE_LOGGING=false

# SMTP for verification and password-reset emails
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="no-reply@example.com"
SMTP_FROM_NAME="Stockeyfy"
