# Copy to .env and fill in. Variables are validated in lib/env.ts.

# PostgreSQL connection string (e.g. Neon, Supabase, local)
DATABASE_URL="postgresql://user:password@localhost:5432/stockeyfy"
# Optional: max pooled connections (1-20)
# DATABASE_POOL_MAX=5

# Auth.js: AUTH_SECRET must be at least 32 characters (npx auth secret)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Trust X-Forwarded-For / X-Real-IP for rate limiting.
# - On Vercel this is automatic; leave unset.
# - Anywhere else (Docker, VPS, Render, Railway, behind Nginx/Caddy/Cloudflare)
#   you MUST set this to true, or per-IP rate limiting is OFF. Limits then
#   apply per email only: one source can spray many accounts, and anyone can
#   lock a real user out of login/password reset by targeting their email.
#   In production the server logs a "[security] Per-IP rate limiting is
#   DISABLED" warning when this is misconfigured.
# - Never enable without a proxy that overwrites these headers, or clients can
#   spoof their IP.
# TRUSTED_PROXY_HEADERS=true
# Optional: log query timings
# PERFORMANCE_LOGGING=false

# SMTP for verification and password-reset emails
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="no-reply@example.com"
SMTP_FROM_NAME="Stockeyfy"
