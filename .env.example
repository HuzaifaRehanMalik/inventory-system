# Neon Postgres (copy the pooled connection string from the Neon Connect dialog)
DATABASE_URL="postgresql://neondb_owner:replace-me@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# Maximum PostgreSQL connections opened by each application instance.
DATABASE_POOL_MAX="5"
# Development logs timings automatically; set this in production only while diagnosing.
PERFORMANCE_LOGGING="false"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# SMTP
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp-user"
SMTP_PASSWORD="smtp-password"
SMTP_FROM_EMAIL="no-reply@example.com"
SMTP_FROM_NAME="Stockeyfy"
