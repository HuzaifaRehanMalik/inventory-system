generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
}

enum InventoryStockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum InventoryActivityType {
  PRODUCT_ADDED
  PRODUCT_UPDATED
  STOCK_RECEIVED
  STOCK_REMOVED
  LOW_STOCK_WARNING
  SETTINGS_UPDATED
}

enum OrderType {
  SALE
  PURCHASE
}

enum OrderStatus {
  DRAFT
  PENDING
  COMPLETED
  CANCELLED
}

model User {
  id                String                 @id @default(cuid())
  name              String                 @db.VarChar(100)
  email             String                 @unique @db.VarChar(320)
  emailVerified     DateTime?
  passwordHash      String?                @db.VarChar(255)
  passwordChangedAt DateTime?
  image             String?
  role              Role                   @default(USER)
  status            AccountStatus          @default(ACTIVE)
  sessionVersion    Int                    @default(0)
  accounts          Account[]
  sessions          Session[]
  passwordResets    PasswordResetToken[]
  categories        Category[]
  products          Product[]
  suppliers         Supplier[]
  customers         Customer[]
  orders            Order[]
  businessSettings  BusinessSettings?
  inventoryActions  InventoryTransaction[] @relation("InventoryTransactionPerformer")
  inventoryActivity InventoryActivity[]    @relation("InventoryActivityOwner")
  performedActivity InventoryActivity[]    @relation("InventoryActivityPerformer")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String   @db.VarChar(320)
  token      String   @unique @db.VarChar(255)
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
  @@index([identifier])
  @@index([expires])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(64)
  expires   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model AuthRateLimit {
  key       String   @id @db.VarChar(64)
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Category {
  id        String    @id @default(cuid())
  ownerId   String
  name      String    @db.VarChar(100)
  products  Product[]
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([ownerId, name])
  @@index([ownerId, createdAt])
}

model Product {
  id           String                 @id @default(cuid())
  ownerId      String
  categoryId   String?
  name         String                 @db.VarChar(160)
  sku          String                 @db.VarChar(80)
  description  String?                @db.VarChar(1000)
  unitPrice    Decimal                @default(0) @db.Decimal(18, 2)
  minimumStock Int                    @default(0)
  active       Boolean                @default(true)
  owner        User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category     Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventory    Inventory?
  transactions InventoryTransaction[]
  activities   InventoryActivity[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([ownerId, sku])
  @@index([ownerId, name])
  @@index([ownerId, categoryId])
  @@index([ownerId, active])
}

model Inventory {
  id              String               @id @default(cuid())
  productId       String               @unique
  quantity        Int                  @default(0)
  status          InventoryStockStatus @default(OUT_OF_STOCK)
  averageUnitCost Decimal              @default(0) @db.Decimal(18, 2)
  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([quantity])
  @@index([status])
  @@index([updatedAt])
}

model Supplier {
  id           String                 @id @default(cuid())
  ownerId      String
  name         String                 @db.VarChar(160)
  email        String?                @db.VarChar(320)
  phone        String?                @db.VarChar(40)
  active       Boolean                @default(true)
  owner        User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([ownerId, name])
  @@index([ownerId, active])
}

model Customer {
  id           String                 @id @default(cuid())
  ownerId      String
  name         String                 @db.VarChar(160)
  email        String?                @db.VarChar(320)
  phone        String?                @db.VarChar(40)
  active       Boolean                @default(true)
  owner        User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([ownerId, name])
  @@index([ownerId, active])
}

model InventoryTransaction {
  id               String                   @id @default(cuid())
  productId        String
  type             InventoryTransactionType
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  unitCost         Decimal                  @default(0) @db.Decimal(18, 2)
  supplierId       String?
  customerId       String?
  counterpartyName String?                  @db.VarChar(160)
  referenceNumber  String?                  @db.VarChar(120)
  notes            String?                  @db.VarChar(2000)
  occurredAt       DateTime
  performedById    String
  product          Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier         Supplier?                @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  customer         Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  performedBy      User                     @relation("InventoryTransactionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  createdAt        DateTime                 @default(now())

  @@index([productId, createdAt])
  @@index([performedById, createdAt])
  @@index([type, occurredAt])
  @@index([supplierId])
  @@index([customerId])
}

model InventoryActivity {
  id            String                @id @default(cuid())
  ownerId       String
  performedById String
  productId     String?
  type          InventoryActivityType
  message       String                @db.VarChar(500)
  owner         User                  @relation("InventoryActivityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  performedBy   User                  @relation("InventoryActivityPerformer", fields: [performedById], references: [id], onDelete: Cascade)
  product       Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())

  @@index([ownerId, createdAt])
  @@index([productId, createdAt])
  @@index([performedById])
}

model Order {
  id              String      @id @default(cuid())
  ownerId         String
  type            OrderType
  status          OrderStatus @default(PENDING)
  referenceNumber String      @db.VarChar(120)
  totalAmount     Decimal     @default(0) @db.Decimal(18, 2)
  owner           User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([ownerId, type, referenceNumber])
  @@index([ownerId, status])
  @@index([ownerId, createdAt])
}

model BusinessSettings {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  companyName              String   @default("My Business") @db.VarChar(160)
  currency                 String   @default("USD") @db.VarChar(3)
  defaultLowStockThreshold Int      @default(5)
  preventNegativeStock     Boolean  @default(true)
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}
